<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="TalbyResxResourceMap" />
  </ItemGroup>

  <!-- Capture user metadata before the SDK supplies convention-based names. -->
  <Target Name="TalbyCaptureResourceMetadata" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Update="@(EmbeddedResource)">
        <TalbyLogicalName>%(EmbeddedResource.LogicalName)</TalbyLogicalName>
        <TalbyManifestResourceName>%(EmbeddedResource.ManifestResourceName)</TalbyManifestResourceName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target
    Name="TalbyWriteResourceMap"
    BeforeTargets="GenerateMSBuildEditorConfigFileCore"
    DependsOnTargets="CreateManifestResourceNames"
  >
    <PropertyGroup>
      <TalbyResxResourceMap>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)TalbyResxResources.txt', '$(MSBuildProjectDirectory)'))</TalbyResxResourceMap>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(TalbyResxResourceMap)"
      Lines="@(EmbeddedResource->'%(FullPath)|%(ManifestResourceName)|%(TalbyLogicalName)|%(TalbyManifestResourceName)|%(Link)|%(WithCulture)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(TalbyResxResourceMap)" />
    </ItemGroup>
  </Target>
</Project>
